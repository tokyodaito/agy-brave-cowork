{
  "manifest_version": 3,
  "name": "Antigravity Cowork for Brave",
  "version": "1.0.0",
  "description": "Локальное расширение для Antigravity CLI: фоновые группы вкладок под задачи, индикатор работы агента, быстрая остановка и доступ к истории/закладкам.",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting",
    "bookmarks",
    "history",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Antigravity Cowork",
    "default_popup": "popup.html"
  }
}
